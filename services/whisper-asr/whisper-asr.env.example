# Copy to /etc/default/whisper-asr, replace the token with exactly 64 lowercase
# hexadecimal characters (for example, from `openssl rand -hex 32`), then set 0600.
WHISPER_INTERNAL_TOKEN=<GENERATE_A_RANDOM_64_HEX_CHARACTER_TOKEN>

WHISPER_MODEL=medium
WHISPER_MODEL_DIRECTORY=/var/lib/whisper-asr/models
WHISPER_JOB_DIRECTORY=/var/lib/whisper-asr/jobs
WHISPER_CPU_THREADS=4
WHISPER_QUEUE_CAPACITY=10
WHISPER_MAX_UPLOAD_BYTES=20971520
WHISPER_MAX_AUDIO_SECONDS=60
WHISPER_RESULT_TTL_SECONDS=1800
WHISPER_CLEANUP_INTERVAL_SECONDS=30
